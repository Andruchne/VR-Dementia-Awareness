  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial-Panels_en-GB
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en-GB
  m_SharedData: {fileID: 11400000, guid: dd0e3d26934d5544c9a9209890b03512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 24431349760
    m_Localized: Welcome to the simulation. Move by pointing your controller and
      pressing [button] to teleport. Take a moment to look around. When you're ready,
      head toward the entrance.
    m_Metadata:
      m_Items: []
  - m_Id: 256351195136
    m_Localized: Enter the house, pick up the [item name] from the table near the
      entrance, then turn right into the living room and place it on the table there.
    m_Metadata:
      m_Items: []
  - m_Id: 367277953024
    m_Localized: 'This is Juliette. She is not animated yet, but you can still talk
      with her.

      Juliette is in an early stage of dementia and believes you
      are her grandchild.

      Press the lower button on your right controller
      to speak.'
    m_Metadata:
      m_Items: []
  - m_Id: 460676714496
    m_Localized: 'Here are some questions you can ask to guide the conversation:

'
    m_Metadata:
      m_Items: []
  - m_Id: 564854837248
    m_Localized: "When you're ready, move toward the [yellow spot name] to experience
      the mood system. You can do this after the conversation ends, or at any time
      if you\u2019d like to leave the conversation."
    m_Metadata:
      m_Items: []
  - m_Id: 666226970624
    m_Localized: Experience each mood one by one while staying on the yellow spot.
      You can look around, but please do not leave the spot. Afterward, you will
      be able to control the moods yourself.
    m_Metadata:
      m_Items: []
  - m_Id: 760586227712
    m_Localized: This was the demo, thank you for playing! You can now return to
      the menu or remove your headset.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
