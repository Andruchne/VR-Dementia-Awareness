  m_TableData:
  - m_Id: 26280443904
    m_Localized: Houd de rechterknop ingedrukt en laat deze los op de plek waar je
      naartoe wilt teleporteren.
    m_Metadata:
      m_Items: []
  - m_Id: 3893969797120
    m_Localized: Duw de linker joystick naar links of rechts om te draaien.
    m_Metadata:
      m_Items: []
  - m_Id: 4217510019072
    m_Localized: Draai je linkerhand naar je gezicht om het menu te openen.
    m_Metadata:
      m_Items: []
  - m_Id: 4270177894400
    m_Localized: Houd de onderste knop op de rechtercontroller ingedrukt om voorwerpen
      vast te pakken.
    m_Metadata:
      m_Items: []
  - m_Id: 667402244947968
    m_Localized: Houd de A-knop op de rechtercontroller ingedrukt om te spreken.
      Laat de knop los wanneer je klaar bent met je bericht.
    m_Metadata:
      m_Items: []
